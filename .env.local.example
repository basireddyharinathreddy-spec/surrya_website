# Gmail SMTP credentials for the enquiry form email feature.
# The app will email enquiry submissions to maheshmahi95944@gmail.com.
#
# SETUP INSTRUCTIONS:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled.
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an App Password (select "Mail" and "Windows Computer")
# 5. Copy the 16-character password shown and paste it below.
# 6. Rename this file from .env.local.example to .env.local
#
# Without these, the app falls back to a test email service (Ethereal)
# that doesn't actually deliver emails — so set these up before going live!

GMAIL_USER=maheshmahi95944@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here
