# =============================================================================
# Enquiry Form Email Configuration
# Submissions will be sent to maheshmahi95944@gmail.com
# =============================================================================

# OPTION 1: Web3Forms (RECOMMENDED for Deployed Sites on Cloudflare, Lovable, Vercel)
# -----------------------------------------------------------------------------
# Web3Forms delivers enquiry emails directly over HTTPS without needing SMTP sockets.
# 1. Visit https://web3forms.com
# 2. Enter maheshmahi95944@gmail.com to receive your free Access Key.
# 3. Paste the Access Key below and add it to your deployment platform's Environment Variables.
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# OPTION 2: Resend API (Alternative HTTPS Email API for Serverless/Edge)
# -----------------------------------------------------------------------------
# 1. Sign up at https://resend.com
# 2. Create an API key and paste below:
RESEND_API_KEY=re_your_resend_api_key_here

# OPTION 3: Gmail SMTP (For local Node.js development or traditional servers)
# -----------------------------------------------------------------------------
# Note: Cloudflare Workers and most edge runtimes block direct outbound SMTP sockets.
# Use Option 1 or 2 for serverless deployments.
GMAIL_USER=maheshmahi95944@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
